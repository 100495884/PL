Grammar

    0 $accept: axioma $end

    1 axioma: programa

    2 programa: variables funciones
    3         | funciones

    4 variables: variable variables
    5          | variable

    6 variable: INTEGER definir ';'
    7         | INTEGER definir ',' definiciones ';'

    8 funciones: funcion funciones
    9          | main

   10 $@1: ε

   11 funcion: IDENTIF $@1 '(' lista_parametros ')' '{' sentencias '}'

   12 lista_parametros: INTEGER IDENTIF ',' lista_parametros
   13                 | INTEGER IDENTIF
   14                 | ε

   15 $@2: ε

   16 main: MAIN $@2 '(' ')' '{' sentencias '}'

   17 sentencias: sentencia ';' sentencias
   18           | sentencia ';'
   19           | estructura sentencias
   20           | estructura

   21 sentencia: INTEGER definir
   22          | INTEGER definir ',' definiciones
   23          | IDENTIF '=' expresion
   24          | IDENTIF '[' expresion ']' '=' expresion
   25          | PRINTF '(' expresion ',' expresiones_print ')'
   26          | PUTS '(' STRING ')'
   27          | IDENTIF '(' enter_parametros ')'
   28          | IDENTIF '(' ')'
   29          | RETURN expresion
   30          | '@' expresion
   31          | '@' condicional

   32 estructura: WHILE '(' condicional ')' '{' sentencias '}'
   33           | IF '(' condicional ')' '{' sentencias_if '}'
   34           | IF '(' condicional ')' '{' sentencias_if '}' ELSE '{' sentencias_if '}'
   35           | FOR '(' inicializ ';' condicional ';' incdec ')' '{' sentencias '}'

   36 sentencias_if: sentencia ';'
   37              | estructura
   38              | sentencia ';' sentencias
   39              | estructura sentencias

   40 inicializ: INTEGER IDENTIF
   41          | INTEGER IDENTIF '=' termino
   42          | IDENTIF '=' termino

   43 incdec: IDENTIF '=' IDENTIF '+' NUMBER
   44       | IDENTIF '=' IDENTIF '-' NUMBER

   45 definiciones: definir ',' definiciones
   46             | definir

   47 definir: IDENTIF '=' termino
   48        | IDENTIF
   49        | IDENTIF '[' NUMBER ']'

   50 expresiones_print: expresion ',' expresiones_print
   51                  | expresion

   52 expresion: termino
   53          | expresion '+' expresion
   54          | expresion '-' expresion
   55          | expresion '*' expresion
   56          | expresion '/' expresion
   57          | expresion '%' expresion
   58          | STRING
   59          | IDENTIF '(' enter_parametros ')'
   60          | IDENTIF '(' ')'
   61          | IDENTIF '[' expresion ']'
   62          | condicional

   63 enter_parametros: expresion ',' enter_parametros
   64                 | expresion

   65 condicional: expresion AND expresion
   66            | expresion OR expresion
   67            | expresion NEQ expresion
   68            | expresion EQ expresion
   69            | expresion '<' expresion
   70            | expresion LEQ expresion
   71            | expresion '>' expresion
   72            | expresion GEQ expresion
   73            | condicional AND condicional
   74            | condicional OR condicional
   75            | condicional NEQ condicional
   76            | condicional EQ condicional
   77            | condicional '<' condicional
   78            | condicional LEQ condicional
   79            | condicional '>' condicional
   80            | condicional GEQ condicional

   81 termino: operando
   82        | '+' operando
   83        | '-' operando

   84 operando: IDENTIF
   85         | NUMBER
   86         | '(' expresion ')'


