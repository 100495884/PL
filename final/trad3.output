    STRING (261) 26 58
    MAIN (262) 16
    WHILE (263) 32
    PUTS (264) 26
    PRINTF (265) 25
    AND (266) 64 72
    OR (267) 65 73
    NEQ (268) 66 74
    EQ (269) 67 75
    LEQ (270) 69 77
    GEQ (271) 71 79
    IF (272) 33 34
    ELSE (273) 34
    FOR (274) 35
    RETURN (275) 29
    UNARY_SIGN (276)


