    '>' (62) 70 78
    '@' (64) 30 31
    '[' (91) 24 49 61
    ']' (93) 24 49 61
    '{' (123) 11 16 32 33 34 35
    '}' (125) 11 16 32 33 34 35
    error (256)
    NUMBER (258) 43 44 49 84
    IDENTIF (259) 11 12 13 23 24 27 28 40 41 42 43 44 47 48 49 59 60 61 83
